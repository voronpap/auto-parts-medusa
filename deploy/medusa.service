# systemd user unit: install to ~/.config/systemd/user/medusa.service
# (needs `loginctl enable-linger vrn` once, so it starts at boot).
# The database is remote and Redis is a system service, so neither is a
# dependency here; Medusa retries its connections on start.
[Unit]
Description=Medusa backend and admin
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/medusa-runtime
Environment=NODE_ENV=production
Environment=PATH=/home/vrn/.nvm/versions/node/v22.22.3/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/medusa-store/apps/backend/.env
ExecStart=/home/vrn/.nvm/versions/node/v22.22.3/bin/pnpm start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0027

[Install]
WantedBy=default.target
