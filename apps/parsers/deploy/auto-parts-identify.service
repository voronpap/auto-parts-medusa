# User unit that answers number searches typed in the admin. Install without root:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/auto-parts-identify.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now auto-parts-identify
#
# CATALOG_API_KEY lives in apps/parsers/.env, which is not in the repository.
[Unit]
Description=Auto parts number identification
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/vrn/medusa-store/apps/parsers
Environment=CATALOG_URL=http://127.0.0.1:9000
Environment=PARSERS_WORKER=identify@vrn-serv
Environment=PARSERS_CACHE=/home/vrn/medusa-store/apps/parsers/.cache/identify.sqlite
EnvironmentFile=/home/vrn/medusa-store/apps/parsers/.env
ExecStart=/home/vrn/medusa-store/apps/parsers/.venv/bin/python -m parsers identify-run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
